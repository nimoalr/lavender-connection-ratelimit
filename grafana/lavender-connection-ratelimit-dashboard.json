{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "description": "Prometheus datasource scraping the FXServer Lavender metrics route.",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "Lavender Connection Rate Limiter",
 "uid": "lavender-connection-ratelimit",
 "description": "FiveM/RedM connection admission queue: depth, throughput, rejections, departures, and queue-wait latency from the lavender-connection-ratelimit resource.",
 "tags": [
  "fivem",
  "fxserver",
  "lavender",
  "connection-queue"
 ],
 "editable": true,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "timezone": "browser",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "refresh": 1,
    "current": {}
   },
   {
    "name": "instance",
    "label": "Instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "query": "label_values(lavender_connection_ratelimit_queue_connections, instance)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Queued connections",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(lavender_connection_ratelimit_queue_connections{instance=~\"$instance\"})",
     "legendFormat": "Queued"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Eligible in queue",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(lavender_connection_ratelimit_queue_eligible_connections{instance=~\"$instance\"})",
     "legendFormat": "Eligible"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#d95926"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "In-flight (loading)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(lavender_connection_ratelimit_in_flight_connections{instance=~\"$instance\"})",
     "legendFormat": "In flight"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#199e70"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Mean queue wait (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(lavender_connection_ratelimit_queue_wait_seconds_sum{instance=~\"$instance\"}[5m])) / sum(rate(lavender_connection_ratelimit_queue_wait_seconds_count{instance=~\"$instance\"}[5m]))",
     "legendFormat": "Mean wait"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#9085e9"
     },
     "noValue": "no admissions"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Queue depth",
   "description": "Waiting, eligible-to-release, and admitted-but-still-loading connections.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(lavender_connection_ratelimit_queue_connections{instance=~\"$instance\"})",
     "legendFormat": "Queued"
    },
    {
     "refId": "B",
     "expr": "sum(lavender_connection_ratelimit_queue_eligible_connections{instance=~\"$instance\"})",
     "legendFormat": "Eligible"
    },
    {
     "refId": "C",
     "expr": "sum(lavender_connection_ratelimit_in_flight_connections{instance=~\"$instance\"})",
     "legendFormat": "In flight"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Queued"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Eligible"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "In flight"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Connection throughput",
   "description": "Attempts seen, attempts accepted into the queue, and deferrals released.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(lavender_connection_ratelimit_connection_attempts_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "Attempts"
    },
    {
     "refId": "B",
     "expr": "sum(rate(lavender_connection_ratelimit_queue_entries_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "Queue entries"
    },
    {
     "refId": "C",
     "expr": "sum(rate(lavender_connection_ratelimit_admissions_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "Admissions"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Attempts"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Queue entries"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Admissions"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Rejections by reason",
   "description": "Attempts rejected before entering the queue, including password-gate failures.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(lavender_connection_ratelimit_rejections_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "{{reason}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 30,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "duplicate"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "queue_full"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "internal_error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "password_failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "password_timeout"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d55181"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Queue departures by reason",
   "description": "How connections leave the queue: released, or removed by disconnect, timeout, or resource stop.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(lavender_connection_ratelimit_queue_departures_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "{{reason}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 30,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "admitted"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "disconnected"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "queue_timeout"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "resource_stop"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Queue wait percentiles",
   "description": "Time spent waiting in the queue before release, from the queue-wait histogram.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(lavender_connection_ratelimit_queue_wait_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.90, sum by (le) (rate(lavender_connection_ratelimit_queue_wait_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "p90"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(lavender_connection_ratelimit_queue_wait_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
     "legendFormat": "p99"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "p50"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#86b6ef"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p90"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "p99"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#1c5cab"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "In-flight timeouts",
   "description": "Admitted connections cleared because playerJoining was never observed. Should stay at zero; sustained values point at loading problems or an undersized inFlightTimeoutSeconds.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 23
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(lavender_connection_ratelimit_in_flight_timeouts_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "In-flight timeouts"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": false
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": false
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#e66767"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "Ticker liveness",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 32
   },
   "panels": []
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Limiter",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(lavender_connection_ratelimit_enabled{instance=~\"$instance\"})"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "On",
         "color": "green"
        },
        "0": {
         "text": "Inert",
         "color": "orange"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Last tick age",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 4,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(lavender_connection_ratelimit_ticker_last_tick_age_seconds{instance=~\"$instance\"})"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "min": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Tick p99 (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 9,
    "y": 33
   },
   "targets": [
